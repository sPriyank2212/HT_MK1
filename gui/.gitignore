# Byte-compiled files: platform- and version-specific, and stale copies get
# imported by mistake.
__pycache__/
*.py[cod]

# Session logs are per-run diagnostic output (brief 3.5 rule 5). Real runs now
# write to a per-user directory, but older builds and the Tk app could drop
# them here.
sessions/

# PyInstaller output. The exe is a build artifact - rebuild it with
# build_exe.cmd rather than committing 8 MB of it.
build/
dist/
*.spec
