# Packaged output from build_exe.cmd — 7.8 MB per exe, rebuildable.
dist/

# Session logs never live here (they go to %LOCALAPPDATA%\HT_MK1\sessions),
# but catch them if --log-dir is pointed at the checkout.
sessions/
