# -*- mode: python ; coding: utf-8 -*-

# The demo: the same program with a virtual tester in place of the hardware
# (demo_main.py).  Build:  python -m PyInstaller HarnessTesterDemo.spec --clean --noconfirm

# Stamp the build time into the program (shown on the Info tab, see
# ui/info_panel.py), not the time the program is started.
import os
from datetime import datetime

with open(os.path.join(SPECPATH, 'build_info.py'), 'w', encoding='utf-8') as _f:
    _f.write('# Generated by HarnessTester.spec or HarnessTesterDemo.spec at build time - do not edit or commit.\n'
             f'BUILD_DATETIME = "{datetime.now():%Y-%m-%d %H:%M}"\n')

a = Analysis(
    ['demo_main.py'],
    pathex=[],
    binaries=[],
    datas=[
        ('profiles/*.json', 'profiles'),
        ('resources', 'resources'),
        # Default connector <-> channel map; see core/paths.py
        ('../netlists/connector_config.xlsx', 'netlists'),
    ],
    hiddenimports=[
        'build_info',       # written above; imported inside a try in ui/info_panel.py
        'PyQt6.QtSvg',      # SVG button icons
        'openpyxl',
        'serial',
        'serial.tools',
        'serial.tools.list_ports',
        'serial.serialutil',
        'serial.serialwin32',
        'reportlab',
        'reportlab.platypus',
        'reportlab.lib',
        'reportlab.lib.colors',
        'reportlab.lib.pagesizes',
        'reportlab.lib.styles',
        'reportlab.lib.units',
        'reportlab.pdfbase',
        'reportlab.pdfbase.pdfmetrics',
        'reportlab.pdfbase.ttfonts',
    ],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[],
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    name='HarnessTesterDemo',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    # UPX-packed exes are flagged far more often by SmartScreen / antivirus.
    upx=False,
    upx_exclude=[],
    console=False,
    icon='resources/app_icon.ico',
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    onefile=True,
)
